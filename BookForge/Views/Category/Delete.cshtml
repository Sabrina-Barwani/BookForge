@model Category

<form method="post">
    <input asp-for="Id" hidden />
    <div class="border p=3 my-4">
        <div class="rounded-end pb-2">
            <h2 class="text-primary"> Delete Category</h2>
            <hr />
        </div>
        <div asp-validation-summary="All"></div>
        <div class="mb-3 row p-1">
            <div class="mb-3 row p-0">
                <label asp-for="Name"></label>
                <input asp-for="Name"disabled class="form-control" />
            </div>
            <div class="mb-3 row p-1">
                <label asp-for="DisplayOrder"></label>
                <input asp-for="DisplayOrder" disabled class="form-control" />

            </div>


        </div>
        <div class="row">
            <div class="col-6 col-md-3">
                <button type="submit" class="btn btn-danger form-control">Delete</button>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Category" asp-action="Index" class="btn btn-secondary form-control border-1">Back To List</a>
            </div>
        </div>


    </div>
</form>

