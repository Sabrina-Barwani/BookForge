@model Product

<form method="post">
    <div class="border p=3 my-4">
        <div class="rounded-end pb-2">
            <h2 class="text-primary"> Delete Product</h2>
            <hr />
        </div>
        <div asp-validation-summary="All"></div>
        <div class="mb-3 row p-1">
            <div class="mb-3 row p-0">
                <label asp-for="Title"></label>
                <input asp-for="Title" class="form-control" readonly/>
            </div>
            <div class="mb-3 row p-1">
                <label asp-for="Description"></label>
                <input asp-for="Description" class="form-control" readonly />

            </div>
            <div class="mb-3 row p-1">
                <label asp-for="Author"></label>
                <input asp-for="Author" class="form-control"  readonly/>


            </div>
            <div class="mb-3 row p-1">
                <label asp-for="ISBN"></label>
                <input asp-for="ISBN" class="form-control" readonly/>


            </div>
            <div class="mb-3 row p-1">
                <label asp-for="ListPrice"></label>
                <input asp-for="ListPrice" class="form-control" readonly />


            </div>
            <div class="mb-3 row p-1">
                <label asp-for="Price"></label>
                <input asp-for="Price" class="form-controlead" readonly/>


            </div>
            <div class="mb-3 row p-1">
                <label asp-for="Price50"></label>
                <input asp-for="Price50" class="form-control" readonly/>


            </div>
            <div class="mb-3 row p-1">
                <label asp-for="Price100"></label>
                <input asp-for="Price100" class="form-control" readonly />


            </div>


        </div>
        <div class="row">
            <div class="col-6 col-md-3">
                <button type="submit" class="btn btn-primary form-control">Delete</button>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Category" asp-action="Index" class="btn btn-secondary form-control border-1">Back To List</a>
            </div>
        </div>


    </div>
</form>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
